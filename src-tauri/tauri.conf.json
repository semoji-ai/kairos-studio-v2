{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kairos Studio",
  "version": "0.1.0",
  "identifier": "com.kairos.studio.v2",
  "build": {
    "frontendDist": "../app/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "resources": {
      "resources/core": "resources/core",
      "resources/dist": "resources/dist",
      "resources/publish_agent.zip": "resources/publish_agent.zip",
      "resources/python-embed": "resources/python-embed"
    }
  }
}
